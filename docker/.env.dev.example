# Override OPZIONALI per lo stack Docker di sviluppo (docker/compose.dev.yml).
# Copiare in docker/.env.dev (ignorato da git) e decommentare solo ciò che serve.

# --- Porte pubblicate sull'host ---
# FRONTEND_HOST_PORT=5173
# BACKEND_HOST_PORT=5001
# DB_HOST_PORT=5433

# --- Credenziali locali ---
# POSTGRES_USER=bibliostack
# POSTGRES_PASSWORD=bibliostack_dev
# POSTGRES_DB=bibliostack
# REDIS_PASSWORD=redis_dev

# --- Segreti applicativi (solo sviluppo!) ---
# JWT_SECRET=...
# JWT_REFRESH=...
# CARD_SECRET=...
# LOG_LEVEL=debug

# --- Integrazioni esterne (facoltative) ---
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# ALLOWED_GOOGLE_DOMAINS=scuola.edu.it
# ALLOW_PUBLIC_REGISTRATION=false
# GOOGLE_BOOKS_API_KEY=...
# RESEND_API_KEY=re_...
